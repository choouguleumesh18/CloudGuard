# Copy to .env for local development. Never use these example values in a deployed environment.
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://cloudguard_user:change_me@localhost:5433/cloudguard
JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret
JWT_EXPIRY_MINUTES=60
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-Immediately-123!
AZURE_MODE=mock
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_DEFAULT_SUBSCRIPTION_ID=
AUTO_REMEDIATE_LOW_RISK=false
EXECUTION_MODE=inline
AUTO_CREATE_SCHEMA=true
RETRY_LIMIT=3
RETRY_BASE_SECONDS=0.25
